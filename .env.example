# Direct connection - para migraciones de Prisma (puerto 5432)
DIRECT_URL=

# Supabase API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
